# Telegram Bot token — get one from @BotFather on Telegram
BOT_TOKEN=your-telegram-bot-token-here

# Default Telegram chat ID to send screenshots to
# Get it by messaging your bot and calling:
#   https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
DEFAULT_CHAT_ID=your-chat-id-here

# Optional: heartbeat-monitor ping URL; the daemon pings it every HEARTBEAT_INTERVAL_MINUTES (default 5).
# Leave unset to disable.
# HEARTBEAT_URL=http://127.0.0.1:8091/ping/web-stalker
# HEARTBEAT_INTERVAL_MINUTES=5
